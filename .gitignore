# Only sanitized public-browser evidence; never raw DOM, cookies, certificates, or profiles.
!/docs/evidence/
/docs/evidence/*
!/docs/evidence/m1-browser/
/docs/evidence/m1-browser/*
!/docs/evidence/m1-browser/public-http-*/
/docs/evidence/m1-browser/public-http-*/*
