erDiagram
    COURSES ||--o{ QUIZZES : contains
    QUIZZES ||--|{ QUIZ_QUESTIONS : includes
    QUIZ_QUESTIONS ||--o{ QUIZ_OPTIONS : offers
    QUIZZES ||--o{ QUIZ_ATTEMPTS : receives
    COURSE_ENROLLMENTS ||--o{ QUIZ_ATTEMPTS : takes
    QUIZ_ATTEMPTS ||--o{ QUIZ_ANSWERS : records
    QUIZ_QUESTIONS ||--o{ QUIZ_ANSWERS : answered_by
    QUIZ_OPTIONS ||--o{ QUIZ_ANSWERS : selected_as
    QUIZ_ATTEMPTS ||--o| QUIZ_GRADES : evaluated_as

    QUIZZES {
      bigint id PK
      bigint tenant_id FK
      bigint course_id FK
      int duration_minutes
      int max_attempts
    }
    QUIZ_QUESTIONS {
      bigint id PK
      bigint tenant_id FK
      bigint quiz_id FK
      varchar question_type
    }
    QUIZ_OPTIONS {
      bigint id PK
      bigint tenant_id FK
      bigint question_id FK
      boolean is_correct
    }
    QUIZ_ATTEMPTS {
      bigint id PK
      bigint tenant_id FK
      bigint course_id FK
      bigint quiz_id FK
      bigint student_profile_id FK
      int attempt_no
    }
    QUIZ_ANSWERS {
      bigint id PK
      bigint tenant_id FK
      bigint quiz_id FK
      bigint attempt_id FK
      bigint question_id FK
      bigint selected_option_id FK "nullable"
    }
    QUIZ_GRADES {
      bigint id PK
      bigint tenant_id FK
      bigint attempt_id FK
    }
