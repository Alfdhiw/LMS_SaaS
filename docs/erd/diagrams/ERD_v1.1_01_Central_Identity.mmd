erDiagram
    TENANTS ||--o{ TENANT_DOMAINS : resolves
    TENANTS ||--o| TENANT_SETTINGS : configures
    TENANTS ||--o{ TENANT_MEMBERSHIPS : contains
    USERS ||--o{ TENANT_MEMBERSHIPS : joins
    USERS ||--o| PLATFORM_STAFF : may_be
    TENANT_MEMBERSHIPS ||--o{ MEMBERSHIP_ROLES : has
    ROLES ||--o{ MEMBERSHIP_ROLES : assigns
    ROLES ||--o{ ROLE_PERMISSIONS : grants
    PERMISSIONS ||--o{ ROLE_PERMISSIONS : grants_tenant_scoped
    TENANTS ||--o{ ACCOUNT_INVITATIONS : hosts
    TENANT_MEMBERSHIPS o|--o{ ACCOUNT_INVITATIONS : activates
    TENANTS o|--o{ ACCOUNT_RECOVERY_REQUESTS : school_scope
    USERS ||--o{ ACCOUNT_RECOVERY_REQUESTS : recovers
    USERS ||--o{ TENANT_PROVISIONING_REQUESTS : requests
    TENANTS o|--o| TENANT_PROVISIONING_REQUESTS : created_by
    PLANS ||--o{ PLAN_FEATURES : contains
    PLANS ||--o{ TENANT_SUBSCRIPTIONS : selected_by
    TENANTS ||--o{ TENANT_SUBSCRIPTIONS : subscribes
    TENANTS ||--o{ TENANT_ENTITLEMENTS : overrides

    TENANTS {
      bigint id PK
      char public_ulid UK
      varchar slug UK
      varchar status "pending active suspended archived"
      varchar timezone
    }
    TENANT_DOMAINS {
      bigint id PK
      bigint tenant_id FK
      varchar hostname UK
      varchar status
    }
    TENANT_SETTINGS {
      bigint tenant_id PK,FK
      varchar logo_object_key "nullable"
      varchar accent_color "nullable"
      jsonb onboarding_json
    }
    USERS {
      bigint id PK
      char public_ulid UK
      varchar email_normalized UK "nullable"
      varchar password "nullable if pending"
      varchar status
      int auth_version
    }
    TENANT_MEMBERSHIPS {
      bigint id PK
      bigint tenant_id FK
      bigint user_id FK
      varchar local_username_normalized "unique per tenant"
      varchar status
      int auth_version
    }
    ACCOUNT_INVITATIONS {
      bigint id PK
      bigint tenant_id FK
      bigint membership_id FK "nullable"
      bigint proposed_role_id FK "nullable"
      char token_hash UK
      varchar purpose
      varchar status
      timestamptz expires_at
    }
    ACCOUNT_RECOVERY_REQUESTS {
      bigint id PK
      bigint tenant_id FK "nullable"
      bigint user_id FK
      char token_hash UK "nullable"
      varchar scope
      varchar status
    }
    TENANT_PROVISIONING_REQUESTS {
      bigint id PK
      bigint actor_user_id FK
      char idempotency_key_hash
      char payload_digest
      bigint tenant_id FK "nullable"
      varchar status
    }
    PLATFORM_STAFF {
      bigint user_id PK,FK
      varchar role
      varchar status
    }
    PERMISSIONS {
      bigint id PK
      varchar key UK
      varchar scope "tenant or platform"
    }
    ROLES {
      bigint id PK
      varchar key UK
    }
    ROLE_PERMISSIONS {
      bigint role_id FK
      bigint permission_id FK
      varchar permission_scope "always tenant"
    }
    PLANS {
      bigint id PK
      varchar code UK
    }
    TENANT_SUBSCRIPTIONS {
      bigint id PK
      bigint tenant_id FK
      bigint plan_id FK
    }
